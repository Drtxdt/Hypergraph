<!doctype html>
<html lang="{{ config.language or 'zh-CN' }}" data-mode="{{ hg().color_mode }}" data-motion="{{ hg().appearance.motion }}"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>{% if page.title %}{{ page.title }} · {% endif %}{{ config.title }}</title><meta name="description" content="{{ hg_excerpt(page) or config.description }}"><link rel="canonical" href="{{ hg_canonical(page) }}">
<script>try{const m=localStorage.getItem('hypergraph-mode');if(m==='light'||m==='dark')document.documentElement.dataset.mode=m}catch{}</script>{{ hg_head() | safe }}<link rel="stylesheet" href="{{ hg_asset('main.css') }}">{{ hg_assets(page) | safe }}{{ hg_seo(page) | safe }}<noscript><style>@media(max-width:1023px){ {% if hg().music.enable %}body{padding-bottom:100px}{% endif %}.site-header nav{display:flex;position:static;height:auto;padding:0;flex-direction:row}.site-header{position:static;height:auto;flex-wrap:wrap}body{padding-top:0}.site-header nav a{font-size:12px}.menu-toggle,.rail-tools{display:none}}</style></noscript></head><body>
{% if hg().appearance.intro != 'off' and hg().appearance.motion == 'cinematic' %}<section data-intro hidden aria-label="{{ hg_t('loading') }}"><div class="intro-identity"><strong>{{ config.title }}</strong><p>{{ config.author }}</p></div><div data-intro-progress><span class="intro-fill"></span><span class="intro-number"><span data-intro-value>0</span>%</span></div><button type="button">{{ hg_t('skip') }}</button></section><script>(function(){try{var h=document.querySelector('[data-intro]'),k='hypergraph:intro:'+'{{ url_for('/') }}'+location.host,m='{{ hg().appearance.intro }}',n=performance.getEntriesByType('navigation')[0];if(location.hash||document.hidden||matchMedia('(prefers-reduced-motion:reduce)').matches||(navigator.connection&&navigator.connection.saveData)||(n&&n.type==='back_forward')||(m==='session'&&sessionStorage.getItem(k)))return;sessionStorage.setItem(k,'1');h.hidden=false;document.documentElement.classList.add('intro-active');setTimeout(function(){h.hidden=true;document.documentElement.classList.remove('intro-active');document.dispatchEvent(new Event('hypergraph:intro-end'));},1200)}catch(e){}})();</script>{% endif %}
<a class="skip-link" href="#content">{{ hg_t('skip') }}</a><header class="site-header"><a class="brand" aria-label="{{ config.title }}" href="{{ url_for('/') }}">{% if hg().site_logo %}<img src="{{ url_for(hg().site_logo) }}" alt="" width="36" height="36">{% else %}<span class="brand-mark" aria-hidden="true">H<span>↗</span></span>{% endif %}</a><button class="rail-expand" data-rail-expand aria-expanded="false" aria-label="{{ hg_t('menu') }}">{{ hg_icon('menu') | safe }}</button><span class="mobile-title">{{ config.title }}</span><button class="menu-toggle" data-menu-toggle aria-expanded="false" aria-controls="site-nav">{{ hg_t('menu') }}</button><nav id="site-nav" aria-label="{{ hg_t('navigation') }}">{{ hg_menu() | safe }}<div class="rail-tools">{% if hg().search %}<button data-search aria-label="{{ hg_t('search') }}">{{ hg_icon('search') | safe }}<span>{{ hg_t('search') }}</span></button>{% endif %}<button data-mode-toggle aria-label="{{ hg_t('mode') }}">{{ hg_icon('mode') | safe }}</button>{% if hg().music.enable %}<button data-player-toggle aria-controls="music-panel" aria-expanded="true" aria-label="{{ hg_t('music') }}">{{ hg_icon('music') | safe }}</button>{% endif %}</div></nav></header>
<main id="content" tabindex="-1" class="layout-endfield"><div class="page-coordinate"><span>{{ config.title }} / {{ config.author }}</span><span>{{ hg_t('latest') }} / {{ site.posts.length }}</span></div>{{ body | safe }}</main>{{ hg_ad("footer") | safe }}<footer class="site-footer"><div><strong>{{ config.title }}</strong><p>{{ config.author }}</p></div><div class="social-links">{% for item in hg().social %}<a href="{{ item.url }}" rel="noopener noreferrer">{{ item.label }}</a>{% endfor %}<p>{{ hg().footer.text }}</p>{{ hg_footer() | safe }}</div><div class="footer-signature">{{ config.title }}<span>{{ config.author }} / {{ date(undefined, 'YYYY') }}</span></div></footer>
{% if hg().music.enable %}<section id="music-panel" class="player" aria-label="{{ hg_t('music') }}"><span>{{ hg().music.title }}</span><button data-player-close aria-label="{{ hg_t('close') }}">×</button><audio controls preload="none" src="{{ url_for(hg().music.src) }}"></audio></section>{% endif %}<div id="navigation-error" role="alert" hidden>{{ hg_t('navigation_error') }} <button>{{ hg_t('retry') }}</button></div>
{% if hg().search %}<dialog id="search-dialog"><div class="dialog-heading"><h2>{{ hg_t('search') }}</h2><button data-close aria-label="{{ hg_t('close') }}">✕</button></div><label for="search-input">{{ hg_t('search_hint') }}</label><input id="search-input" type="search" autocomplete="off"><p role="status"></p><ol data-results></ol></dialog>{% endif %}<script id="hg-config" type="application/json">{{ hg_runtime() | safe }}</script><script type="module" src="{{ hg_asset('main.js') }}"></script>{{ hg_slot("footer") | safe }}{% for html in hg().inject.body %}{{ html | safe }}{% endfor %}</body></html>
