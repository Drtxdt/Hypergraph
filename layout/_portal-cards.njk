{% for group, items in (page.links or []) | groupby('group') %}<section class="portal-group">{% if group %}<h2>{{ group }}</h2>{% endif %}<div class="portal-grid">{% for item in items %}<a class="portal-card" href="{{ hg_link(item.url) }}" rel="noopener noreferrer">{% if item.image %}<img src="{{ hg_image(item.image) }}" alt="" width="480" height="240" loading="lazy">{% else %}<span class="portal-emblem">{{ hg_icon(item.icon or 'link') | safe }}</span>{% endif %}<h3>{{ item.title }}</h3><p>{{ item.description }}</p><span class="portal-arrow" aria-hidden="true">↗</span></a>{% endfor %}</div></section>{% endfor %}
