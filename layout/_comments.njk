{% if hg().comments.enable and page.comments != false and not page.password and not page.hg_encrypted %}<section class="comments-section"><h2>{{ hg_t('comments') }}</h2>{% if hg().comments.provider == "waline" and hg().comments.count %}<p>{{ hg_t("comments") }}: <span data-comment-count="{{ hg().comments.server }}">…</span></p>{% endif %}{% if hg().comments.provider == "waline" and hg().comments.recent %}<details><summary>{{ hg_t("comments") }}</summary><div data-comment-recent="{{ hg().comments.server }}">…</div></details>{% if hg().comments.barrage %}<button data-barrage aria-pressed="false">{{ hg_t('barrage') }}</button>{% endif %}{% endif %}<div id="waline" data-comments><script type="application/json" data-comment-config>{{ hg_json(hg().comments) | safe }}</script><div data-comment-body></div><p role="status"></p></div><noscript>{{ hg_t('comments_js') }}</noscript></section>{% endif %}
