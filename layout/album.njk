{% from '_heading.njk' import heading with context %}<a class="parent-link" href="{{ url_for(page.parent) }}">← {{ hg_t('gallery') }}</a>{{ heading(page.title, page.photos.length, page.description, 1, hg_t('photos')) }}
<section class="collection-gallery photo-grid">{% for photo in page.photos %}<figure><a href="{{ hg_image(photo.image) }}"><img src="{{ hg_image(photo.image) }}" alt="{{ photo.caption or photo.title }}" width="{{ photo.width or 600 }}" height="{{ photo.height or 400 }}" loading="lazy"></a>{% if photo.caption or photo.title %}<figcaption>{{ photo.caption or photo.title }}</figcaption>{% endif %}</figure>{% endfor %}</section>{% if not page.photos.length %}<p class="empty-state">{{ hg_t('empty') }}</p>{% endif %}{% include '_comments.njk' %}
