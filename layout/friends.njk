{% from '_heading.njk' import heading with context %}{{ heading(page.title, null, page.description, 1) }}
{% for group in page.groups %}{% if group.items.length %}<section class="portal-group">{% if group.title %}<h2>{{ group.title }}</h2>{% endif %}<div class="friend-grid">{% for item in group.items %}<a class="friend-card" href="{{ hg_link(item.url) }}" rel="noopener noreferrer">{% if item.avatar or item.image %}<img src="{{ hg_image(item.avatar or item.image) }}" alt="" width="56" height="56" loading="lazy">{% else %}{{ hg_icon('users') | safe }}{% endif %}<div><h3>{{ item.title }}</h3><p>{{ item.description }}</p></div><span aria-hidden="true">↗</span></a>{% endfor %}</div></section>{% endif %}{% else %}<p class="empty-state">{{ hg_t('empty') }}</p>{% endfor %}
{% if page.application %}<section class="about-section"><h2>{{ hg_t('friend_application') }}</h2><p>{{ page.application }}</p></section>{% endif %}{% include '_comments.njk' %}
