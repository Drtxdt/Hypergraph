{% set media = hg_media(page, "page") %}
<section class="article-head"><p class="eyebrow">{{ hg_t('personal_space') }} / {{ page.title }}</p><div class="section-title"><h1>{{ page.title }}</h1></div><p>{{ page.description }}</p></section>{% include '_media.njk' %}<section class="collection collection-{{ page.type }}">{% for item in page.items %}<article class="collection-card">{% if item.image %}<img src="{{ hg_image(item.image) }}" alt="{{ item.title }}" width="600" height="400" loading="lazy">{% endif %}{% if item.date %}<time>{{ item.date }}</time>{% endif %}<h2>{% if item.url %}<a href="{{ item.url }}" rel="noopener noreferrer">{{ item.title }} ↗</a>{% else %}{{ item.title }}{% endif %}</h2><p>{{ item.description }}</p>{% if item.audio %}<audio controls preload="none" src="{{ url_for(item.audio) }}"></audio>{% endif %}{% if item.status %}<span class="collection-status">{{ item.status }}</span>{% endif %}</article>{% else %}<p class="empty-state">{{ hg_t('empty') }}</p>{% endfor %}</section>{% include '_comments.njk' %}
{% if page.remote %}<section data-remote-feed="{{ page.remote }}" aria-live="polite">{{ hg_t('loading') }}</section>{% endif %}
