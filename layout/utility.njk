{% from '_heading.njk' import heading with context %}<a class="parent-link" href="{{ url_for(page.parent) }}">← {{ hg_t(page.type) }}</a>{{ heading(page.title, null, null if page.type == 'games' else hg_t(page.app + '_description'), 1) }}
{% if page.type == 'tools' %}<section class="utility" data-utility="{{ page.app }}"><label for="utility-input">{{ hg_t('input') }} · 1 MiB<textarea id="utility-input" spellcheck="false"></textarea></label><div class="utility-actions">{% if page.app == 'json' %}{% set actions=['format','minify','validate'] %}{% elif page.app == 'text' %}{% set actions=['count'] %}{% else %}{% set actions=['url_encode','url_decode','base64_encode','base64_decode'] %}{% endif %}{% for action in actions %}<button disabled class="icon-button" data-operation="{{ action }}" title="{{ hg_t(action) }}" aria-label="{{ hg_t(action) }}">{{ hg_icon(action) | safe }}</button>{% endfor %}<button disabled class="icon-button" data-clear title="{{ hg_t('clear') }}" aria-label="{{ hg_t('clear') }}">{{ hg_icon('clear') | safe }}</button></div><label for="utility-output">{{ hg_t('output') }}<textarea id="utility-output" readonly></textarea></label><div class="utility-actions"><button disabled class="icon-button" data-copy-output title="{{ hg_t('copy') }}" aria-label="{{ hg_t('copy') }}">{{ hg_icon('copy') | safe }}</button></div><p class="utility-status" role="status" aria-live="polite"></p></section>
{% else %}<section class="game-shell" data-game-app="{{ page.app }}"><p class="game-status" role="status" aria-live="polite"></p><div class="game-board" data-game="{{ page.app }}" tabindex="0" aria-label="{{ page.title }}"></div><div class="game-controls"><button disabled class="icon-button" data-new-game title="{{ hg_t('new_game') }}" aria-label="{{ hg_t('new_game') }}">{{ hg_icon('new_game') | safe }}</button><button disabled class="icon-button" data-resume title="{{ hg_t('continue') }}" aria-label="{{ hg_t('continue') }}">{{ hg_icon('continue') | safe }}</button>{% if page.app == '2048' %}{% for direction, label in [[0,'←'],[1,'↑'],[2,'→'],[3,'↓']] %}<button disabled class="icon-button" data-direction="{{ direction }}" aria-label="{{ hg_t('direction_' + direction) }}">{{ label }}</button>{% endfor %}{% else %}<button disabled class="icon-button" data-flag-mode aria-pressed="false" title="{{ hg_t('flag') }}" aria-label="{{ hg_t('flag') }}">{{ hg_icon('flag') | safe }}</button>{% endif %}</div><p>{{ hg_t(page.app + '_help') }}</p></section>{% endif %}
<noscript><p>{{ hg_t('utility_js') }}</p></noscript>
