{% from '_heading.njk' import heading with context %}{{ heading(page.title, null, page.description, 1) }}
<section class="album-grid">{% for album in page.albums %}<a class="album-card" href="{{ url_for(hg_page_path('gallery') + album.slug + '/') }}">{% if album.cover or album.photos[0].image %}<img src="{{ hg_image(album.cover or album.photos[0].image) }}" alt="" width="600" height="400" loading="lazy">{% endif %}<h2>{{ album.title }}</h2><p>{{ album.description }}</p><small>{{ album.photos.length }} {{ hg_t('photos') }} ↗</small></a>{% endfor %}</section>

{% if not page.albums.length %}<p class="empty-state">{{ hg_t('empty') }}</p>{% endif %}{% include '_comments.njk' %}
