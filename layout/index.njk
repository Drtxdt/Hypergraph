{% from "_heading.njk" import heading with context %}
{{ hg_slot("home:before") | safe }}
{% set selection = hg_selection(page) %}
{% for section in hg().home.sections %}
{% if section == 'intro' %}<section class="home-introduction">
{% if hg().appearance.avatar %}<img src="{{ url_for(hg().appearance.avatar) }}" alt="" width="56" height="56">{% endif %}
<div class="home-identity"><h1>{{ hg().home.title or config.title }}</h1>{% if config.author and config.author != config.title %}<span>{{ config.author }}</span>{% endif %}{% if hg().home.description or config.description %}<p>{{ hg().home.description or config.description }}</p>{% endif %}{% if hg().appearance.author_status %}<small>{{ hg().appearance.author_status }}</small>{% endif %}</div>
<nav aria-label="{{ hg_t('navigation') }}">{% for cat in site.categories.sort('length', -1).limit(3).toArray() %}<a href="{{ url_for(cat.path) }}">{{ cat.name }}</a>{% endfor %}{% if hg().pages.about.enable %}<a class="identity-about" href="{{ url_for('/about/') }}">{{ hg_t('about') }} ↗</a>{% endif %}</nav>
</section>{% endif %}
{% if section == 'featured' and selection.lead %}{% set post = selection.lead %}{% set media = hg_media(post, "home") %}
<section class="lead {% if media.has_image %}has-image{% else %}text-only{% endif %}" aria-label="{{ hg_t('featured') }}">
<div class="lead-copy"><div class="section-kicker"><span>{{ hg_t('featured') }}</span><div><time>{{ date(post.date,'YYYY.MM.DD') }}</time>{% if not media.has_image %} / {{ hg_reading(post) }} {{ hg_t('min_read') }}{% endif %}</div></div><div class="lead-title"><div class="categories">{% for cat in post.categories.toArray() %}<a href="{{ url_for(cat.path) }}">{{ cat.name }}</a>{% endfor %}</div><h2 class="lead-heading"><a href="{{ url_for(post.path) }}">{{ post.title }}</a></h2>{% if hg_home_excerpt(post) %}<p>{{ hg_home_excerpt(post) }}</p>{% endif %}</div><a class="lead-link" href="{{ url_for(post.path) }}"><span>{{ hg_t('read') }}</span><span aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a></div>
{% if media.has_image %}<a class="lead-media" href="{{ url_for(post.path) }}" aria-label="{{ post.title }}"><img src="{{ media.url }}" alt="" width="900" height="1000" style="object-position:{{ media.position }}" fetchpriority="high"><span class="media-coordinate" aria-hidden="true">{{ hg_reading(post) }} {{ hg_t('min_read') }}</span></a>{% endif %}
</section>{% endif %}
{% if section == 'posts' and selection.posts.length %}<div class="home-body {% if hg().sidebar.enable %}with-sidebar{% endif %}"><section id="latest" class="record-section">{{ heading(hg_t('latest'), site.posts.length) }}<div class="posts">{% for post in selection.posts %}{% set record_media = hg_media(post, "record") %}<article class="entry home-entry {% if (post.cover or post.banner) and record_media.has_image %}has-media{% endif %}"><div class="meta"><time>{{ date(post.date,'YYYY.MM.DD') }}</time></div>{% if (post.cover or post.banner) and record_media.has_image %}<a class="entry-media" href="{{ url_for(post.path) }}" tabindex="-1" aria-hidden="true"><img src="{{ record_media.url }}" alt="" width="640" height="400" loading="lazy" style="object-position:{{ record_media.position }}"></a>{% endif %}<div class="entry-copy"><div class="categories">{% for cat in post.categories.toArray() %}<a href="{{ url_for(cat.path) }}">{{ cat.name }}</a>{% endfor %}</div><h2><a href="{{ url_for(post.path) }}">{{ post.title }}</a></h2>{% if hg_home_excerpt(post) %}<p>{{ hg_home_excerpt(post) }}</p>{% endif %}<div class="record-status">{% if post.sticky %}<span>{{ hg_t('pinned') }}</span>{% endif %}{% if post.password or post.hg_encrypted %}<span>{{ hg_t('locked') }}</span>{% endif %}{% for tag in post.tags.limit(2).toArray() %}<a href="{{ url_for(tag.path) }}">#{{ tag.name }}</a>{% endfor %}</div><div class="entry-bottom"><span>{{ hg_reading(post) }} {{ hg_t('min_read') }}</span><a href="{{ url_for(post.path) }}" aria-label="{{ hg_t('read') }}: {{ post.title }}"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div></div></article>{% else %}{% if not selection.lead %}<p class="empty-state">{{ hg_t('empty') }}</p>{% endif %}{% endfor %}</div></section>{{ hg_widgets() | safe }}</div>{% endif %}{% if section == 'posts' and page.total > 1 %}<div class="pagination">{{ paginator() | safe }}</div>{% endif %}
{% endfor %}
{{ hg_ad("home") | safe }}

{% if not selection.lead and not selection.posts.length %}<section class="empty-state">{% if 'intro' not in hg().home.sections %}<h1>{{ config.title }}</h1>{% endif %}<p>{{ hg_t('empty') }}</p></section>{% endif %}
