{{ hg_slot("home:before") | safe }}
{% set selection = hg_selection(page) %}
{% for section in hg().home.sections %}
{% if section == 'intro' %}<section class="home-introduction"><h1>{{ hg().home.title or config.title }}</h1><p>{{ hg().home.description or config.description }}</p></section>{% endif %}
{% if section == 'featured' and selection.lead %}{% set post = selection.lead %}{% set media = hg_media(post, "home") %}
<section class="lead {% if media.has_image %}has-image{% else %}text-only{% endif %}" aria-label="{{ hg_t('featured') }}">
<div class="lead-copy"><div class="section-kicker"><span>01 / {{ hg_t('featured') }}</span><div><time>{{ date(post.date,'YYYY.MM.DD') }}</time>{% if not media.has_image %} / {{ hg_reading(post) }} {{ hg_t('min_read') }}{% endif %}</div></div><div class="lead-title"><div class="categories">{% for cat in post.categories.toArray() %}<a href="{{ url_for(cat.path) }}">{{ cat.name }}</a>{% endfor %}</div><h1><a href="{{ url_for(post.path) }}">{{ post.title }}</a></h1><p>{{ hg_home_excerpt(post) }}</p></div><a class="lead-link" href="{{ url_for(post.path) }}"><span>{{ hg_t('read') }}</span><span aria-hidden="true"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></span></a></div>
{% if media.has_image %}<div class="lead-media"><img src="{{ media.url }}" alt="" width="900" height="1000" style="object-position:{{ media.position }}" fetchpriority="high"><span class="media-coordinate" aria-hidden="true">{{ date(post.date,'YYYY.MM.DD') }} / {{ hg_reading(post) }} {{ hg_t('min_read') }}</span></div>{% endif %}
</section>{% endif %}
{% if section == 'posts' %}<div class="home-body {% if hg().sidebar.enable %}with-sidebar{% endif %}"><section id="latest" class="record-section"><div class="section-heading"><h2>{{ hg_t('latest') }}</h2><span>INDEX / {{ site.posts.length }}</span></div><div class="posts">{% for post in selection.posts %}{% set record_media = hg_media(post, "record") %}<article class="entry home-entry {% if (post.cover or post.banner) and record_media.has_image %}has-media{% endif %}"><div class="meta"><span class="entry-index">{{ loop.index }}</span><time>{{ date(post.date,'YYYY.MM.DD') }}</time></div>{% if (post.cover or post.banner) and record_media.has_image %}<a class="entry-media" href="{{ url_for(post.path) }}" tabindex="-1" aria-hidden="true"><img src="{{ record_media.url }}" alt="" width="640" height="400" loading="lazy" style="object-position:{{ record_media.position }}"></a>{% endif %}<div class="entry-copy"><div class="categories">{% for cat in post.categories.toArray() %}<a href="{{ url_for(cat.path) }}">{{ cat.name }}</a>{% endfor %}</div><h2><a href="{{ url_for(post.path) }}">{{ post.title }}</a></h2><p>{{ hg_home_excerpt(post) }}</p><div class="entry-bottom"><span>{{ hg_reading(post) }} {{ hg_t('min_read') }}</span><a href="{{ url_for(post.path) }}" aria-label="{{ hg_t('read') }}: {{ post.title }}"><svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M5 19 19 5M5 5h14v14"/></svg></a></div></div></article>{% else %}{% if not selection.lead %}<p class="empty-state">{{ hg_t('empty') }}</p>{% endif %}{% endfor %}</div></section>{{ hg_widgets() | safe }}</div><div class="pagination">{{ paginator() | safe }}</div>{% endif %}
{% endfor %}
{{ hg_ad("home") | safe }}
