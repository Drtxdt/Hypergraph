<article class="article"><aside class="article-metadata">{% for item in hg_post_meta(page).split(" / ") %}<span>{{ item | safe }}</span>{% endfor %}</aside><header class="article-head"><h1>{{ page.title }}</h1>{% if page.description %}<p class="article-description">{{ page.description }}</p>{% endif %}<div class="article-tools"><div class="categories">{% for cat in page.categories.toArray() %}<a href="{{ url_for(cat.path) }}">{{ cat.name }}</a>{% endfor %}</div>{% if hg().reading_mode %}<button class="icon-button" data-reading aria-pressed="false" aria-label="{{ hg_t('reading') }}" title="{{ hg_t('reading') }}">{{ hg_icon("reading") | safe }}</button>{% endif %}{% if hg().toc %}<aside class="toc-panel toc-mobile"{% if not toc(page.content) %} hidden{% endif %}><details id="mobile-toc"><summary aria-label="{{ hg_t('toc') }}" title="{{ hg_t('toc') }}"><svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="1.5" aria-hidden="true"><path d="M3 5h2m4 0h12M3 12h2m4 0h12M3 19h2m4 0h12"/></svg><span class="toc-label">{{ hg_t('toc') }}</span></summary><button class="icon-button toc-close" data-toc-close aria-label="{{ hg_t('close') }}">{{ hg_icon("close") | safe }}</button>{{ toc(page.content) | safe }}</details></aside>{% endif %}</div></header>{% set media = hg_media(page) %}{% set cover_mode = page.cover_mode or hg().post.cover_mode %}{% if media.has_image and cover_mode != 'none' %}<figure class="article-cover cover-{{ cover_mode }}" style="--media-height:{{ media.height }}px"><img src="{{ media.url }}" alt="" width="1200" height="500" style="object-position:{{ media.position }}"></figure>{% endif %}<div class="reading-grid {% if not hg().toc %}without-toc{% endif %}">{% if hg().toc %}<aside class="toc-panel toc-desktop"{% if not toc(page.content) %} hidden{% endif %}><details id="desktop-toc" open><summary aria-label="{{ hg_t('toc') }}" title="{{ hg_t('toc') }}">{{ hg_icon("menu") | safe }}<span class="toc-label">{{ hg_t('toc') }}</span></summary>{{ toc(page.content) | safe }}</details></aside>{% endif %}<div>{{ hg_post_tools(page) | safe }}<div class="prose">{{ page.content | safe }}</div><div class="post-tags">{% for tag in page.tags.toArray() %}<a href="{{ url_for(tag.path) }}">#{{ tag.name }}</a>{% endfor %}</div></div></div>{% if hg().post.related and hg_related(page).length %}<section class="related"><h2>{{ hg_t('related') }}</h2>{% for post in hg_related(page) %}<a href="{{ url_for(post.path) }}">{{ post.title }} ↗</a>{% endfor %}</section>{% endif %}<div class="article-end">{{ hg_post_end(page) | safe }}{% include "_slots.njk" %}</div></article>
{{ hg_ad("post") | safe }}
