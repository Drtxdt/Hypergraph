<article class="article"><header class="article-head"><p class="eyebrow">FIELD NOTE / {{ hg_post_meta(page) }}</p><h1>{{ page.title }}</h1>{% if page.description %}<p class="article-description">{{ page.description }}</p>{% endif %}<div class="article-tools"><div class="categories">{% for cat in page.categories.toArray() %}<a href="{{ url_for(cat.path) }}">{{ cat.name }}</a>{% endfor %}</div>{% if hg().reading_mode %}<button data-reading aria-pressed="false">{{ hg_t('reading') }}</button>{% endif %}</div></header>{% set media = hg_media(page) %}{% if media.has_image %}<figure class="article-cover" style="--media-height:{{ media.height }}px"><img src="{{ media.url }}" alt="" width="1200" height="500" style="object-position:{{ media.position }}"></figure>{% endif %}<div class="reading-grid {% if not hg().toc %}without-toc{% endif %}">{% if hg().toc %}<aside class="toc-panel"><details open><summary>{{ hg_t('toc') }}</summary>{{ toc(page.content) | safe }}</details></aside>{% endif %}<div>{{ hg_post_tools(page) | safe }}<div class="prose">{{ page.content | safe }}</div><div class="post-tags">{% for tag in page.tags.toArray() %}<a href="{{ url_for(tag.path) }}">#{{ tag.name }}</a>{% endfor %}</div><div class="post-credit">{{ config.author }} · <a href="{{ hg_canonical(page) }}">{{ hg_t('permalink') }}</a></div></div></div>{% if hg().post.related %}<section class="related"><h2>{{ hg_t('related') }}</h2>{% for post in hg_related(page) %}<a href="{{ url_for(post.path) }}">{{ post.title }} ↗</a>{% endfor %}</section>{% endif %}</article>
{{ hg_post_end(page) | safe }}{% include "_slots.njk" %}
{{ hg_ad("post") | safe }}
