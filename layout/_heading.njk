{% macro heading(title, count, description, level=2, unit=null) %}
<header class="section-heading">
  <div><h{{ level }}>{{ title }}</h{{ level }}>{% if description %}<p>{{ description }}</p>{% endif %}</div>
  {% if count != null %}<span>{{ count }} {{ unit or hg_t('articles') }}</span>{% endif %}
</header>
{% endmacro %}
