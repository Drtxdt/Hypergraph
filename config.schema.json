{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "color_mode": {
      "enum": [
        "auto",
        "light",
        "dark"
      ],
      "default": "auto"
    },
    "menu": {
      "type": "array",
      "default": [
        {
          "label": "home",
          "url": "/",
          "icon": "home"
        },
        {
          "label": "archives",
          "url": "/archives/",
          "icon": "archive"
        }
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "label"
        ],
        "properties": {
          "label": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "icon": {
            "type": "string",
            "enum": [
              "home",
              "archive",
              "about",
              "image",
              "music",
              "link",
              "grid",
              "user",
              "users"
            ]
          },
          "children": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "label",
                "url"
              ],
              "properties": {
                "label": {
                  "type": "string"
                },
                "url": {
                  "type": "string"
                }
              }
            },
            "minItems": 1
          }
        },
        "oneOf": [
          {
            "required": [
              "url"
            ],
            "not": {
              "required": [
                "children"
              ]
            }
          },
          {
            "required": [
              "children"
            ],
            "not": {
              "required": [
                "url"
              ]
            }
          }
        ]
      }
    },
    "home": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "title": {
          "type": "string",
          "default": ""
        },
        "description": {
          "type": "string",
          "default": ""
        },
        "featured": {
          "type": "boolean",
          "default": true
        },
        "sections": {
          "type": "array",
          "uniqueItems": true,
          "default": [
            "featured",
            "posts"
          ],
          "items": {
            "enum": [
              "intro",
              "featured",
              "posts"
            ]
          }
        },
        "excerpt_length": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000,
          "default": 160
        },
        "excerpt": {
          "enum": [
            "auto",
            "description",
            "off"
          ],
          "default": "auto"
        }
      }
    },
    "navigation": {
      "type": "boolean",
      "default": true
    },
    "search": {
      "type": "boolean",
      "default": true
    },
    "toc": {
      "type": "boolean",
      "default": true
    },
    "reading_mode": {
      "type": "boolean",
      "default": true
    },
    "math": {
      "enum": [
        "katex",
        "mathjax",
        "off"
      ],
      "default": "katex"
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "enable": {
          "type": "boolean",
          "default": false
        },
        "src": {
          "type": "string",
          "default": ""
        },
        "title": {
          "type": "string",
          "default": "Background music"
        },
        "playlist": {
          "type": "array",
          "default": [],
          "items": {
            "type": "object",
            "additionalProperties": false,
            "default": {},
            "properties": {
              "title": {
                "type": "string",
                "default": ""
              },
              "src": {
                "type": "string",
                "default": ""
              }
            }
          }
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.7
        },
        "endpoint": {
          "type": "string",
          "default": ""
        }
      }
    },
    "comments": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "enable": {
          "type": "boolean",
          "default": false
        },
        "provider": {
          "enum": [
            "waline",
            "artalk",
            "twikoo",
            "giscus",
            "disqus",
            "disqusjs",
            "livere",
            "valine",
            "utterances",
            "facebook",
            "remark42",
            "gitalk"
          ],
          "default": "waline"
        },
        "server": {
          "type": "string",
          "default": ""
        },
        "site": {
          "type": "string",
          "default": ""
        },
        "env_id": {
          "type": "string",
          "default": ""
        },
        "repo": {
          "type": "string",
          "default": ""
        },
        "repo_id": {
          "type": "string",
          "default": ""
        },
        "category_id": {
          "type": "string",
          "default": ""
        },
        "count": {
          "type": "boolean",
          "default": false
        },
        "recent": {
          "type": "boolean",
          "default": false
        },
        "barrage": {
          "type": "boolean",
          "default": false
        },
        "shortname": {
          "type": "string",
          "default": ""
        },
        "api_key": {
          "type": "string",
          "default": ""
        },
        "uid": {
          "type": "string",
          "default": ""
        },
        "app_id": {
          "type": "string",
          "default": ""
        },
        "app_key": {
          "type": "string",
          "default": ""
        },
        "client_id": {
          "type": "string",
          "default": ""
        },
        "client_secret": {
          "type": "string",
          "default": ""
        },
        "owner": {
          "type": "string",
          "default": ""
        },
        "proxy": {
          "type": "string",
          "default": ""
        },
        "admin": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          }
        },
        "lazy": {
          "type": "boolean",
          "default": false
        },
        "options": {
          "type": "object",
          "default": {}
        },
        "secondary": {
          "type": "object",
          "additionalProperties": false,
          "default": {},
          "properties": {
            "enable": {
              "type": "boolean",
              "default": false
            },
            "provider": {
              "enum": [
                "waline",
                "artalk",
                "twikoo",
                "giscus",
                "disqus",
                "disqusjs",
                "livere",
                "valine",
                "utterances",
                "facebook",
                "remark42",
                "gitalk"
              ],
              "default": "waline"
            },
            "server": {
              "type": "string",
              "default": ""
            },
            "site": {
              "type": "string",
              "default": ""
            },
            "env_id": {
              "type": "string",
              "default": ""
            },
            "repo": {
              "type": "string",
              "default": ""
            },
            "repo_id": {
              "type": "string",
              "default": ""
            },
            "category_id": {
              "type": "string",
              "default": ""
            },
            "shortname": {
              "type": "string",
              "default": ""
            },
            "api_key": {
              "type": "string",
              "default": ""
            },
            "uid": {
              "type": "string",
              "default": ""
            },
            "app_id": {
              "type": "string",
              "default": ""
            },
            "app_key": {
              "type": "string",
              "default": ""
            },
            "client_id": {
              "type": "string",
              "default": ""
            },
            "client_secret": {
              "type": "string",
              "default": ""
            },
            "owner": {
              "type": "string",
              "default": ""
            },
            "proxy": {
              "type": "string",
              "default": ""
            },
            "admin": {
              "type": "array",
              "default": [],
              "items": {
                "type": "string"
              }
            },
            "lazy": {
              "type": "boolean",
              "default": false
            },
            "options": {
              "type": "object",
              "default": {}
            }
          }
        }
      }
    },
    "colors": {
      "type": "object",
      "additionalProperties": false,
      "default": {},
      "properties": {
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
